# Images built locally by default. Production must use the approved registry.
REGISTRY=localhost/mpb
IMAGE_TAG=dev

# Host ports
CKAN_PORT_HOST=5000
NGINX_PORT_HOST=8080
NGINX_SSLPORT_HOST=8443

# Local development endpoint. Replace it in production.
CKAN_SITE_URL=http://localhost:5000

# PostgreSQL / CKAN Datastore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres
POSTGRES_HOST=db
CKAN_DB_USER=ckandbuser
CKAN_DB_PASSWORD=CHANGE_ME
CKAN_DB=ckandb
DATASTORE_READONLY_USER=datastore_ro
DATASTORE_READONLY_PASSWORD=CHANGE_ME
DATASTORE_DB=datastore
CKAN_SQLALCHEMY_URL=postgresql://ckandbuser:CHANGE_ME@db/ckandb
CKAN_DATASTORE_WRITE_URL=postgresql://ckandbuser:CHANGE_ME@db/datastore
CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:CHANGE_ME@db/datastore

# Test database connections
TEST_CKAN_SQLALCHEMY_URL=postgresql://ckandbuser:CHANGE_ME@db/ckan_test
TEST_CKAN_DATASTORE_WRITE_URL=postgresql://ckandbuser:CHANGE_ME@db/datastore_test
TEST_CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:CHANGE_ME@db/datastore_test

# CKAN
CKAN_VERSION=2.11
CKAN_SITE_ID=default
CKAN___BEAKER__SESSION__SECRET=CHANGE_ME
CKAN___API_TOKEN__JWT__ENCODE__SECRET=string:CHANGE_ME
CKAN___API_TOKEN__JWT__DECODE__SECRET=string:CHANGE_ME
CKAN_SYSADMIN_NAME=ckan_admin
CKAN_SYSADMIN_PASSWORD=CHANGE_ME
CKAN_SYSADMIN_EMAIL=admin@example.org
CKAN_STORAGE_PATH=/var/lib/ckan
CKAN_MAX_UPLOAD_SIZE_MB=100
TZ=America/Sao_Paulo

# Solr
SOLR_IMAGE_VERSION=2.11-solr9
CKAN_SOLR_URL=http://solr:8983/solr/ckan
TEST_CKAN_SOLR_URL=http://solr:8983/solr/ckan

# Redis
REDIS_VERSION=6
CKAN_REDIS_URL=redis://redis:6379/1
TEST_CKAN_REDIS_URL=redis://redis:6379/1

# DataPusher
DATAPUSHER_VERSION=0.0.21
CKAN_DATAPUSHER_URL=http://datapusher:8800
CKAN__DATAPUSHER__CALLBACK_URL_BASE=http://ckan:5000

# Internal Nginx ports
NGINX_PORT=80
NGINX_SSLPORT=443

CKAN__PLUGINS="mpb scheming_datasets activity image_view text_view datatables_view pdf_view datastore datapusher envvars"

# Authorization
CKAN__AUTH__ANON_CREATE_DATASET=false
CKAN__AUTH__CREATE_UNOWNED_DATASET=false
CKAN__AUTH__CREATE_DATASET_IF_NOT_IN_ORGANIZATION=false
CKAN__AUTH__USER_CREATE_ORGANIZATIONS=false
CKAN__AUTH__USER_DELETE_ORGANIZATIONS=false
CKAN__AUTH__USER_CREATE_GROUPS=false
CKAN__AUTH__USER_DELETE_GROUPS=false
CKAN__AUTH__CREATE_USER_VIA_WEB=false
CKAN__AUTH__CREATE_USER_VIA_API=false
CKAN__AUTH__PUBLIC_USER_DETAILS=false
CKAN__AUTH__PUBLIC_ACTIVITY_STREAM_DETAIL=false

# Portal organization and pipeline service user (ckan mpb setup-portal)
CKANEXT__MPB__ORGANIZATION__NAME=movimento-pela-base
CKANEXT__MPB__ORGANIZATION__TITLE="Movimento pela Base"
CKANEXT__MPB__PIPELINE_USER__NAME=mpb-pipelines
CKANEXT__MPB__PIPELINE_USER__EMAIL=pipelines@example.org

# Locale
CKAN__LOCALE_DEFAULT=pt_BR
