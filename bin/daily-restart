#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="${ROOT}/docker-compose.yml"

cd "${ROOT}"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Parando os serviços..."
docker compose -f "${COMPOSE_FILE}" down

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Subindo os serviços e aguardando healthchecks..."
docker compose -f "${COMPOSE_FILE}" up -d --wait

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Serviços saudáveis."
