FROM ckan/ckan-dev:2.11

USER root

RUN  pip3 install  -e "git+https://github.com/ckan/ckanext-scheming.git@8d303d5040d44e666c5651d00e7cec4f615f0c25#egg=ckanext-scheming" && \
    pip3 install -e 'git+https://github.com/ckan/ckanext-pdfview.git@0.0.9#egg=ckanext-pdfview'
    
COPY --chown=ckan-sys:ckan-sys docker-entrypoint.d/* /docker-entrypoint.d/
COPY --chmod=755 setup/start_ckan_development_with_extensions.sh /usr/local/sbin/
COPY --chown=ckan-sys:ckan-sys patches ${APP_DIR}/patches
COPY ./ckan_dataset_schema.yaml ${APP_DIR}/src/ckanext-scheming/ckanext/scheming


#USER ckan

RUN for d in $APP_DIR/patches/*; do \
        if [ -d $d ]; then \
            for f in `ls $d/*.patch | sort -g`; do \
                cd $SRC_DIR/`basename "$d"` && echo "$0: Applying patch $f to $SRC_DIR/`basename $d`"; patch -p1 < "$f" ; \
            done ; \
        fi ; \
    done

CMD ["/usr/local/sbin/start_ckan_development_with_extensions.sh"]
